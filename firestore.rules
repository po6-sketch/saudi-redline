rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && request.auth.token.email == 'so70.90p@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /participations/{id} {
      allow read: if resource.data.status == 'approved' || admin();
      allow create: if request.resource.data.keys().hasOnly(['name','message','imageUrl','status','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 600
        && request.resource.data.imageUrl is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if admin();
    }

    match /pledges/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow read: if admin();
      allow update, delete: if admin();
    }
  }
}