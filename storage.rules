rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      return request.auth != null
        && request.auth.token.email == 'PUT_YOUR_ADMIN_EMAIL_HERE'
        && request.auth.token.email_verified == true;
    }
    match /participation-images/{participationId}/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if admin();
    }
  }
}